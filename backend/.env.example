# Copy this file to .env and fill in real values. Never commit .env itself.

# Raw Cookie header from a logged-in browser request to jobright.ai/jobs/recommend
# (browser devtools -> Network tab -> any request to jobright.ai -> copy the
# "cookie" request header value). Expires periodically and must be refreshed.
JOBRIGHT_COOKIE=

# Optional override. Defaults to mock mode when JOBRIGHT_COOKIE is unset,
# real mode when it is set. Force one or the other with "true" / "false".
# JOBRIGHT_MOCK_MODE=true

# --- DeepSeek (web session, no API key) ------------------------------------
# Skill extraction drives chat.deepseek.com in a browser using your logged-in
# session, so no paid platform.deepseek.com key is needed.
#
# Preferred: a Playwright storage-state file holding BOTH cookies and the
# localStorage `userToken` that DeepSeek actually authenticates with. Generate
# it with:  ..\venv\Scripts\python.exe scripts\capture_deepseek_session.py
DEEPSEEK_STORAGE_STATE=secrets/deepseek_session.json

# Alternatives if you'd rather export by hand (see docs/deepseek-session.md).
# A Cookie-Editor / EditThisCookie JSON export:
# DEEPSEEK_COOKIE_FILE=secrets/deepseek_cookies.json
# Or a raw "a=1; b=2" Cookie header copied from DevTools. Cookies alone are
# NOT enough — pair this with DEEPSEEK_USER_TOKEN below.
# DEEPSEEK_COOKIES=
# DEEPSEEK_USER_TOKEN=

# Set false to watch the automation in a visible window — useful when a
# Cloudflare check blocks headless access.
# DEEPSEEK_HEADLESS=true

# Mock is OPT-IN only — normally leave this unset so extraction always hits
# the real DeepSeek. With no session configured the backend raises a clear
# auth error instead of quietly returning fake skills.
# DEEPSEEK_MOCK_MODE=true
